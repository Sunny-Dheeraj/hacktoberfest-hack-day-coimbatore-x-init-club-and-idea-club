# ProofPath Environment Configuration

# Optional GitHub Personal Access Token (for higher rate limits: 5000/hr vs 60/hr)
GITHUB_TOKEN=

# API Server Port
PORT=8000

# Repository Collection Limits
MAX_REPOSITORIES=5
MAX_FILES_PER_REPOSITORY=40
MAX_FILE_SIZE=100000
MAX_TOTAL_SOURCE_SIZE=1000000
GITHUB_API_TIMEOUT=15.0

# Google Cloud Managed Gemma 4 Configuration (Phase 2)
# Target model: gemma-4-26b-a4b-it-maas in Vertex AI Model Garden / MaaS
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMMA_MODEL=gemma-4-26b-a4b-it-maas

# Optional API Key for Generative AI / Vertex AI MaaS endpoint
GEMMA_API_KEY=
GOOGLE_GENAI_API_KEY=

# Optional OAuth Bearer Token for Vertex AI REST calls
GOOGLE_OAUTH_TOKEN=

# Gemma API Timeout (seconds)
GEMMA_TIMEOUT=30.0
